<!-- Mobile Menu -->
<div
    id="mobileMenu"
    class="fixed inset-0 bg-white dark:bg-dark-background z-50 transform translate-x-full transition-transform duration-300"
>
    <div class="container mx-auto px-4 h-full flex flex-col">
        <div class="flex justify-between items-center py-4">
            <div class="flex items-center">
                <span class="text-xl font-extrabold">Trevor Hunte</span>
                <span class="text-primary text-2xl ml-1">&bull;</span>
            </div>
            <button id="closeMenu" class="p-2">
                <i
                    class="fa-solid fa-square-xmark text-gray-600 dark:text-gray-400 text-2xl"
                ></i>
            </button>
        </div>
        <ul class="flex-1 flex flex-col justify-center items-center space-y-8">
            <li>
                <a
                    href="#features"
                    class="text-2xl text-gray-700 dark:text-gray-300 hover:text-primary
                        dark:hover:text-primary transition-colors"
                    >Showcase</a
                >
            </li>
            <li>
                <a
                    href="#projects"
                    class="text-2xl text-gray-700 dark:text-gray-300 hover:text-primary
                        dark:hover:text-primary transition-colors"
                    >Projects</a
                >
            </li>

            <li>
                <a
                    href="#skills"
                    class="text-2xl text-gray-700 dark:text-gray-300 hover:text-primary
                        dark:hover:text-primary transition-colors"
                    >Skills</a
                >
            </li>

            <li>
                <a
                    href="#contact"
                    class="text-2xl text-gray-700 dark:text-gray-300 hover:text-primary
                        dark:hover:text-primary transition-colors"
                    >Contact</a
                >
            </li>
        </ul>
    </div>
</div>
