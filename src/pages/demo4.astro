---
import "../styles/demo4.css";
import office from "../assets/cert/office.png";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <script src="../scripts/demo4.js"></script>
        <!--=============== REMIXICONS ===============-->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.7.0/remixicon.css"
        />
        <!--=============== Database ===============-->
        <script
            src="https://cdn.jsdelivr.net/npm/pouchdb@9.0.0/dist/pouchdb.min.js"
        ></script>
        <title>demo4</title>
    </head>
    <body>
        <section class="login">
            <div class="log__wrapper">
                <div class="log__img">
                    <img src={office.src} alt="login Image" />
                </div>
                <div class="log__form">
                    <h1>Login</h1>

                    <form action="" id="login-form">
                        <label for="username">Username</label>
                        <span class="input__name">
                            <i class="ri-user-3-line"></i>
                            <input
                                id="username"
                                type="text"
                                placeholder="Enter username"
                                autocomplete="on"
                                autofocus
                                name="username"
                            />
                        </span>
                        <label for="password">Password</label>
                        <span class="input__password">
                            <i class="ri-lock-2-line"></i>
                            <input
                                id="password"
                                type="password"
                                placeholder="Enter password"
                                autocomplete="on"
                                name="password"
                            />
                        </span>
                        <div class="forget__password">
                            <a href="http://">forgot password</a>
                        </div>
                        <button class="login__btn"> Login</button>
                    </form>

                    <div class="sign__in__icons">
                        <p>or continue with</p>
                        <div class="icon__list">
                            <a data-social="google" style="--scolour:#d04535"
                                ><i class="ri-google-line"></i></a
                            >
                            <a data-social="twitter" style="--scolour:black"
                                ><i class="ri-twitter-x-fill"></i></a
                            >
                            <a data-social="facebook" style="--scolour:#365897"
                                ><i class="ri-facebook-fill"></i></a
                            >
                        </div>
                    </div>
                    <div class="sign__up">
                        <p>or continue with</p>
                        <a href="demo4_reg">SIGN UP</a>
                    </div>
                </div>
            </div>
        </section>
        <div class="popup" id="popup">
            <div class="title__area">Message</div>
            <p></p>
        </div>
    </body>
</html>
