---
import "../styles/demo1.css";
import shanai from "../assets/manage_landing_page/avatar-shanai.png";
import richard from "../assets/manage_landing_page/avatar-richard.png";
import anisha from "../assets/manage_landing_page/avatar-anisha.png";
import tutorBg from "../assets/manage_landing_page/ai-tutor-logo-removebg.png";
import tutorStudentBg from "../assets/manage_landing_page/ai-tutor-student-no-bg.png";
import ali from "../assets/manage_landing_page/avatar-ali.png";
import hamburger from "../assets/manage_landing_page/icon-hamburger.svg";
import closeIcon from "../assets/manage_landing_page/icon-close.svg";

// import facebook from "../assets/manage_landing_page/facebook.svg";
// import youtube from "/assets/manage_landing_page/social-icons.svg#icon-youtube";
// import instagram from "assets/manage_landing_page/social-icons.svg#icon-instagram";
// import pinteres from "/assets/manage_landing_page/social-icons.svg#icon-pinteres";
// import twitter from "src/assets/manage_landing_page/social-icons.svg#icon-twitter";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
            rel="stylesheet"
        />

        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.7.0/remixicon.css"
        />
        <script src="../scripts/demo1.js"></script>
        <!-- <link rel="stylesheet" href="../styles/demo1.css" /> -->

        <!-- slider -->
        <link
            rel="stylesheet"
            href="//unpkg.com/a11y-slider@latest/dist/a11y-slider.css"
        />

        <script src="//unpkg.com/a11y-slider@latest/dist/a11y-slider.js" defer
        ></script>

        <title>Project 1</title>
    </head>
    <body>
        <header class="primary-header">
            <div class="contain">
                <div class="nav-wrapper">
                    <a href="#">
                        <img src={tutorBg.src} width="146" alt="logo" />
                    </a>

                    <!-- Mobile Navigation -->
                    <button
                        class="mobile-nav-toggle"
                        aria-controls="primary-navigation"
                        aria-expanded="false"
                    >
                        <span class="visually-hidden">Menu</span>
                        <img
                            class="icon-close"
                            src={closeIcon.src}
                            alt=""
                            aria-hidden="true"
                        />
                        <img
                            class="icon-hambuger"
                            src={hamburger.src}
                            alt=""
                            aria-hidden="true"
                        />
                    </button>

                    <!-- Header Navigation -->
                    <nav class="primary-navigation" id="primary-navigation">
                        <ul aria-label="Primary" role="list" class="nav-list">
                            <li><a href="#home">Home</a></li>
                            <li><a href="#tutoring">Tutoring</a></li>
                            <li><a href="#testimonials">Testimonials</a></li>
                            <li><a href="#pricing">Pricing</a></li>
                            <li><a href="#contact">Contact</a></li>
                        </ul>
                    </nav>
                    <button class="button get-started display-md-inline-block"
                        >Get Started</button
                    >
                </div>
            </div>
        </header>

        <!-- Main -->
        <main>
            <!-- registration form -->
            <div class="register-form">
                <div class="form-close" id="form-close">
                    <h2 class="fs-secondary-heading fw-bold">Register Child</h2>
                    <i class="ri-close-line"></i>
                </div>
                <form action="">
                    <div>
                        <label for="p-name">Parent's Name</label>
                        <input type="text" id="p-name" />
                        <label for="p-email">Parent's Email</label>
                        <input type="email" id="p-email" />
                        <label for="c-name">Child's Name</label>
                        <input type="text" id="c-name" />

                        <label for="grade">Choose Grade</label>
                        <select name="" id="grade">
                            <option value="grade_1">Grade 1</option>
                            <option value="grade_2">Grade 2</option>
                            <option value="grade_3">Grade 3</option>
                            <option value="grade_4">Grade 4</option>
                            <option value="grade_5">Grade 5</option>
                            <option value="grade_6">Grade 6</option>
                        </select>
                    </div>
                    <div>
                        <span>
                            <input type="checkbox" value="math" id="math" />
                            <label for="math">Math</label>
                        </span>
                        <span>
                            <input
                                type="checkbox"
                                value="science"
                                id="science"
                            />
                            <label for="science">Science</label>
                        </span>
                        <span>
                            <input
                                type="checkbox"
                                value="language"
                                id="language"
                            />
                            <label for="language">Language Arts</label>
                        </span>
                        <span>
                            <input type="checkbox" value="social" id="social" />
                            <label for="social">Social Studies</label>
                        </span>
                        <span>
                            <input
                                type="checkbox"
                                value="general"
                                id="general"
                            />
                            <label for="general">General</label>
                        </span>
                        <button
                            type="submit"
                            class="button"
                            id="register"
                            data-shadow="none"
                        >
                            Register</button
                        >
                    </div>
                </form>
            </div>
            <!-- Hero Section -->
            <section
                class="hero | text-center-sm-only padding-block-700"
                id="home"
            >
                <div class="contain">
                    <div class="even-columns">
                        <!-- Hero Text -->
                        <div class="flow">
                            <h1 class="fs-primary-heading fw-bold">
                                Give your child the edge they deserve.
                            </h1>
                            <p>
                                AI tutor makes it simple for easy for your child
                                to excel in every discipline.
                            </p>
                            <button class="button get-started"
                                >Get Started</button
                            >
                        </div>

                        <!-- Hero Image -->
                        <div class="hero-image mx-auto">
                            <img src={tutorStudentBg.src} alt="" />
                            <div class="bottom-transition"></div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Hero Section end -->

            <!-- Manage Descriptions -->
            <section class="sales-point | padding-block-700" id="tutoring">
                <div class="contain">
                    <div class="even-columns">
                        <div
                            class="flow text-center-sm-only margin-bottom-700"
                            style="--flow-spacer:1.5rem"
                        >
                            <h2 class="fs-secondary-heading fw-bold">
                                What's different about AI Tutor?
                            </h2>
                            <p>
                                AI Tutor provides all the learning needs your
                                child requires, without complexity. Our AI Tutor
                                is versed in every area of study from human
                                sciences to engineering.
                            </p>
                        </div>
                        <div>
                            <ul class="numbered-items flow" role="list">
                                <li>
                                    <div
                                        class="flow"
                                        style="--flow-spacer:1rem"
                                    >
                                        <h3
                                            class="numbered-items-title fs-600 fw-bold"
                                        >
                                            Track your child's progress
                                        </h3>
                                        <p
                                            class="numbered-items-body"
                                            data-width="wide"
                                        >
                                            See how your child does day-to-day.
                                            Go from tracking progress at the
                                            milestone level all the way done to
                                            the smallest of details. Know exctly
                                            your child's strengths and
                                            weaknesses.
                                        </p>
                                    </div>
                                </li>
                                <li>
                                    <div
                                        class="flow"
                                        style="--flow-spacer:1rem"
                                    >
                                        <h3
                                            class="numbered-items-title fs-600 fw-bold"
                                        >
                                            Advanced built-in reports
                                        </h3>
                                        <p
                                            class="numbered-items-body"
                                            data-width="wide"
                                        >
                                            Set knowledge targets and exams and
                                            track progress toward desired goals.
                                            Our customisable dashboard helps you
                                            build out the reports you need to
                                            track your child's progress.
                                        </p>
                                    </div>
                                </li>
                                <li>
                                    <div
                                        class="flow"
                                        style="--flow-spacer:1rem"
                                    >
                                        <h3
                                            class="numbered-items-title fs-600 fw-bold"
                                        >
                                            Everything you need in one place
                                        </h3>
                                        <p
                                            class="numbered-items-body"
                                            data-width="wide"
                                        >
                                            Stop jumping from one service to
                                            another to assist your child.
                                            Elevate your child to be the best
                                            and achieve the most. AI tutor
                                            offers an all-in-one serive to
                                            maximize productivity.
                                        </p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Manage Descriptions End -->

            <!-- Carousel -->
            <section
                class="carousel padding-block-700 txt-center"
                id="testimonials"
            >
                <h2 class="fs-secondary-heading fw-bold">What they've said</h2>
                <ul class="slider">
                    <!-- Testimonial 1 -->

                    <li>
                        <img src={anisha.src} alt="" />
                        <div class="flow">
                            <h3 class="fw-bold">Anisha Li</h3>
                            <p data-width="wide">
                                AI Tutor has supercharged my child's growth. The
                                ability to see my child improve in real time
                                brings comfort.”
                            </p>
                        </div>
                        <div class="sider-card-shade"></div>
                    </li>
                    <!-- Testimonial 2 -->
                    <li>
                        <img data-width="wide" src={ali.src} alt="" />
                        <div class="flow">
                            <h3 class="fw-bold">Ali Bravo</h3>
                            <p data-width="wide">
                                “We have been able to cancel so many other
                                subscriptions since using AI Tutor. My child
                                stays fully focused, and enjoys his lessons.”
                            </p>
                        </div>
                        <div class="sider-card-shade"></div>
                    </li>
                    <!-- Testimonial 3 -->
                    <li>
                        <img src={richard.src} alt="" />
                        <div class="flow">
                            <h3 class="fw-bold">Richard Watts</h3>
                            <p data-width="wide">
                                AI Tutor allows us to provide structure and
                                process. It keeps my son organized and focused.
                                I can’t stop recommending them to everyone I
                                talk to!”
                            </p>
                        </div>
                        <div class="sider-card-shade"></div>
                    </li>
                    <!-- Testimonial 4 -->
                    <li>
                        <img src={shanai.src} alt="" />
                        <div class="flow">
                            <h3 class="fw-bold">Shanai Gough</h3>
                            <p data-width="wide">
                                “Their software allows us to track, manage and
                                schedule study from anywhere. The AI tutor is
                                amazingly reponsive with my daughter".
                            </p>
                        </div>
                        <div class="sider-card-shade"></div>
                    </li>
                </ul>
                <button class="button carousel-btn get-started"
                    >Get Started</button
                >
            </section>
            <!-- Carousel End -->

            <!-- Pricing Section -->
            <section class="pricing padding-block-700" id="pricing">
                <div class="contain">
                    <h2
                        class="fs-secondary-heading fw-bold txt-center margin-bottom-700"
                    >
                        Choose Your Plan
                    </h2>

                    <div class="even-columns">
                        <!-- Card 1 -->
                        <div class="price-card txt-center">
                            <h3 class="fs-700 fw-bold">Teacher</h3>
                            <h1 class="fs-primary-heading padding-block-500">
                                $25/m
                            </h1>
                            <p class="txt-center padding-block-500">
                                Weekly Assignments
                            </p>
                            <p class="txt-center padding-block-500">
                                Weekly Tutoring
                            </p>
                            <p class="txt-center padding-block-500"></p>
                            <p class="txt-center padding-block-500"></p>
                            <button class="button">Select</button>
                        </div>

                        <!-- Card 2 -->
                        <div class="price-card txt-center">
                            <h3 class="fs-700 fw-bold">Scholar</h3>
                            <h1 class="fs-primary-heading padding-block-500">
                                $50/m
                            </h1>
                            <p class="txt-center padding-block-500">
                                Weekly Assignments
                            </p>
                            <p class="txt-center padding-block-500">
                                Daily Tutoring
                            </p>
                            <p class="txt-center padding-block-500">
                                Focused Lesson Plans
                            </p>
                            <p class="txt-center padding-block-500"></p>
                            <button class="button" data-type="inverted"
                                >Select</button
                            >
                        </div>
                        <!-- Card 3 -->
                        <div class="price-card txt-center">
                            <h3 class="fs-700 fw-bold">Nobel</h3>
                            <h1 class="fs-primary-heading padding-block-500">
                                $100/m
                            </h1>
                            <p class="txt-center padding-block-500">
                                Weekly Assignments
                            </p>
                            <p class="txt-center padding-block-500">
                                Daily Tutoring
                            </p>
                            <p class="txt-center padding-block-500">
                                Personalised Lesson Plans
                            </p>
                            <p class="txt-center padding-block-500">
                                24 Hour Support
                            </p>
                            <button class="button">Select</button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Pricing End -->

            <!-- Call To Action -->
            <section
                class="cta | padding-block-900 bkg-accent-400 txt-neutral-100"
            >
                <div class="contain">
                    <div class="even-columns vertical-align-center">
                        <div>
                            <p class="fs-primary-heading fw-bold">
                                Elevate your child's learning today!.
                            </p>
                        </div>
                        <div class="justify-self-end-md">
                            <button
                                class="button get-started"
                                data-type="inverted">Get Started</button
                            >
                        </div>
                    </div>
                </div>
            </section>
            <!-- Call To Action End -->
            <!-- footer -->
            <footer
                class="primary-footer | bkg-neutral-900 txt-neutral-100 padding-block-700"
                id="contact"
            >
                <div class="contain">
                    <div class="even-columns">
                        <div class="primary-footer-logo-social">
                            <a href="#" aria-label="home">
                                <img src={tutorBg.src} alt="" />
                            </a>
                            <ul
                                role="list"
                                aria-label="Social Links"
                                class="social-list"
                            >
                                <li>
                                    <!-- <a aria-label="Facebook" href="">
                                    <svg class="social-icon">
                                        <use xlink:href={facebook}></use>
                                    </svg>
                                </a> -->
                                </li>
                                <li>
                                    <!-- <a aria-label="YouTube" href="">
                                    <svg class="social-icon">
                                        <use xlink:href={youtube}></use>
                                    </svg>
                                </a> -->
                                </li>
                                <li>
                                    <!-- <a aria-label="Twitter" href="">
                                    <svg class="social-icon">
                                        <use xlink:href={instagram}></use>
                                    </svg>
                                </a> -->
                                </li>
                                <li>
                                    <!-- <a aria-label="Pinterest" href="">
                                    <svg class="social-icon">
                                        <use xlink:href={pinteres}></use>
                                    </svg>
                                </a> -->
                                </li>
                                <li>
                                    <!-- <a aria-label="Instagram" href="">
                                    <svg class="social-icon">
                                        <use xlink:href={twitter}></use>
                                    </svg>
                                </a> -->
                                </li>
                            </ul>
                            <p data-copywrite="small-screen">
                                Copyright 2020. All Rights Reserved
                            </p>
                        </div>
                        <div>
                            <nav aria-label="Footer" class="footer-nav">
                                <ul
                                    class="flow"
                                    style="--flow-spacer:1em"
                                    role="list"
                                >
                                    <li><a href="#home">Home</a></li>
                                    <li><a href="#tutoring">Tutoring</a></li>
                                    <li>
                                        <a href="#testimonials">Testimonials</a>
                                    </li>
                                    <li><a href="#pricing">Pricing</a></li>
                                    <li><a href="#contact">Contact</a></li>
                                </ul>
                            </nav>
                        </div>
                        <div class="primary-footer-form">
                            <form action="">
                                <input
                                    type="email"
                                    name=""
                                    id=""
                                    placeholder="name@email.com"
                                />
                                <button class="button" data-shadow="none"
                                    >Contact</button
                                >
                            </form>
                            <p data-copywrite="large-screen">
                                &#169; All Rights Reserved By T.Hunte
                            </p>
                        </div>
                    </div>
                </div>
            </footer>
        </main>
    </body>
</html>
