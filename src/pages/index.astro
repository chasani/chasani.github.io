---
import Hero from "../components/Hero_p.astro";
import Layout from "../layouts/Layout_p.astro";
import Card from "../components/Card_inset_p.astro";
import tutorBg from "../assets/manage_landing_page/tutor-site-bg.png";
import marketBg from "../assets/market/market-site-bg.png";
import bakeryBg from "../assets/bakery/bakery-site-bg.png";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<style>
		#stack {
			display: flex;
			flex-basis: 50%;
			max-height: 100vh;
			align-items: center;
			justify-content: center;
		}

		.postit {
			margin-top: 2px;
			max-width: 350px;
			border-radius: 2rem;
			position: absolute;
			/* animation: 1s ease-in-out forwards spinout; */
			transition:
				transform 1s ease-in,
				opacity 1s ease-in;
		}

		.test-area h1 {
			/* display: inline block; */
			transform: translate3d(0, 3rem, 0);
			animation: 3s linear forwards rise;
		}

		.curtain-text {
			/* transform: translate3d(0, 3rem, 0); */
			/* animation: 3s linear forwards rise; */
		}

		.curtain-text::after {
			/* content: "";
			position: absolute;
			background-color: #f8f8ff;
			opacity: 0.7;
			border-top: 1px solid black;
			height: 7rem;
			inset: 0;
			 transform: translate3d(0, 1rem, 0);
			animation: 5s ease-out forwards drop;
			z-index: 4; */
		}

		.curtain {
			position: absolute;
			background-color: #f8f8ff;
			opacity: 0;
			border-top: 1px solid black;
			height: 7rem;
			inset: 0;
			/* animation: 5s ease-out forwards drop; */
		}

		/* @keyframes drop {
			0% {
				transform: translate3d(0, 0, 0);
			}
			50%,
			70% {
				transform: translate3d(0, 2rem, 0);
				scale: 1;
				height: 1px;
			}
			100% {
				transform: translate3d(0, 2rem, 0);
				background-color: white;
				scale: 0;
				height: 1px;
			}
		}
		@keyframes rise {
			to {
				transform: translate3d(0, 0, 0);
			}
		} */

		.p-card {
			clip-path: path(
				"M 10,40 L 128,40 A 10,10 0,0,0 138,30 L 138,10 A 10,10 0,0,1 148,0 L 374,0 A 10,10 0,0,1 384,10 L 384,362 A 10,10 0,0,1 374,372 L 354,372 A 10,10 0,0,0  344,382 L 344,490 A 10,10 0,0,1 334,500 L 10,500 A 10,10 0,0,1 0,490 L 0,50 A 10,10 0,0,1 10,40 Z"
			);
		}

		@media only screen and (max-width: 600px) {
			.postit {
				display: none;
			}
			#stack {
				display: none;
			}
		}
		/* infinite horizontal scroll */

		.logos {
			align-content: center;
		}

		.logos::before {
			content: "";
			background-image: linear-gradient(to left, transparent, white);
			/* background-color: black; */

			position: absolute;
			inset: 0 90% 0 0;
			z-index: 1;
		}
		html.dark section#skills .logos::before {
			background-image: linear-gradient(to left, transparent, black);
		}

		.logos::after {
			content: "";
			background-image: linear-gradient(to right, transparent, white);
			/* background-color: red; */

			position: absolute;
			inset: 0 0 0 90%;
			z-index: 1;
		}

		html.dark section#skills .logos::after {
			background-image: linear-gradient(to right, transparent, black);
		}

		.logos-slide {
			display: inline-block;
			animation: slide 35s linear alternate infinite;
		}

		.logos-slide ul li {
			margin: 0 2rem;
			/* background-color: #f9fafb; */
			width: 10rem;
			height: 5rem;
			display: flex;
			justify-content: center;
			align-items: center;
			gap: 0.5rem;
			border-radius: 100vw;
			border: 0;
		}

		.logos:hover .logos-slide {
			animation-play-state: paused;
		}

		@keyframes slide {
			from {
				transform: translateX(0);
			}
			to {
				transform: translateX(-100%);
			}
		}
	</style>
	<!-- Hero section -->
	<div class="container flex flex-row">
		<Hero />
		<div id="stack" class="min-h-screen">
			<!-- Postit 1 -->
			<div
				class="postit h-[350px] p-8 bg-gray-50 shadow-xl dark:bg-dark-background-tertiary"
			>
				<div
					class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6"
				>
					<i class="fa-solid fa-paintbrush text-primary text-xl"></i>
				</div>
				<h3 class="text-xl font-bold mb-10">Morden UI Design</h3>
				<p class="text-gray-600 dark:text-gray-400">
					Creating beautiful, responsive interfaces that look great on
					any device using the latest design
				</p>
			</div>
			<!-- Postit 2 -->
			<div
				class="postit h-[350px] p-8 bg-white opacity-0 shadow-xl dark:bg-dark-background-tertiary"
			>
				<div
					class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6"
				>
					<i class="fa-solid fa-code text-primary text-xl"></i>
				</div>
				<h3 class="text-xl font-bold mb-10">Clean Code</h3>
				<p class="text-gray-600 dark:text-gray-400">
					Writing maintainable, efficient code following best
					practices and mordern development standards.
				</p>
			</div>
			<!-- Postit 3 -->
			<div
				class="postit h-[350px] p-8 bg-gray-50 dark:bg-dark-background-tertiary opacity-0 shadow-xl"
			>
				<div
					class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6"
				>
					<i class="fa-solid fa-bolt text-primary text-xl"></i>
				</div>
				<h3 class="text-xl font-bold mb-10">
					Performance Optimization
				</h3>
				<p class="text-gray-600 dark:text-gray-400">
					Ensuring fast load times and smooth experiencesthrough
					efficient code and asset optimisation.
				</p>
			</div>
			<!-- Posit 4 -->
			<div
				class="postit h-[350px] p-8 bg-white shadow-xl opacity-0 dark:bg-dark-background-tertiary"
			>
				<div
					class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mb-6"
				>
					<i class="fa-solid fa-mobile-alt text-primary text-xl"></i>
				</div>
				<h3 class="text-xl font-bold mb-10">Responsive Developer</h3>
				<p class="text-gray-600 dark:text-gray-400">
					Building websites that work flawlessly across all screen
					sizes, from phones to large displays.
				</p>
			</div>
		</div>
	</div>
