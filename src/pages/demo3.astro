---
import "../styles/demo3.css";
import marketLogo from "../assets/market/logo-2-sm.png";
import banana from "../assets/market/banana.png";
import bananaThumb1 from "../assets/market/banana-thumb-1.png";
import bananaThumb2 from "../assets/market/banana-thumb-2.png";
import bananaThumb3 from "../assets/market/banana-thumb-3.png";
import bananaThumb4 from "../assets/market/banana-thumb-4.png";
import bananaVid from "../assets/market/banana-vid.mp4";

import mango from "../assets/market/mango.png";
import mangoThumb1 from "../assets/market/mango-thumb-1.png";
import mangoThumb2 from "../assets/market/mango-thumb-2.png";
import mangoThumb3 from "../assets/market/mango-thumb-3.png";
import mangoThumb4 from "../assets/market/mango-thumb-4.png";
import mangoVid from "../assets/market/mango-vid.mp4";

import waterApple from "../assets/market/water-apple.png";
import waterAppleThumb1 from "../assets/market/water-apple-thumb-1.png";
import waterAppleThumb2 from "../assets/market/water-apple-thumb-2.png";
import waterAppleThumb3 from "../assets/market/water-apple-thumb-3.png";
import waterAppleThumb4 from "../assets/market/water-apple-thumb-4.png";
import waterAppleVid from "../assets/market/water-apple-vid.mp4";

import sugarApple from "../assets/market/sugar-apple.png";
import sugarAppleThumb1 from "../assets/market/sugar-apple-thumb-1.png";
import sugarAppleThumb2 from "../assets/market/sugar-apple-thumb-2.png";
import sugarAppleThumb3 from "../assets/market/sugar-apple-thumb-3.png";
import sugarAppleThumb4 from "../assets/market/sugar-apple-thumb-4.png";
import sugarAppleVid from "../assets/market/sugar-apple-vid.mp4";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <script src="../scripts/demo3.js"></script>

        <!--=============== REMIXICONS ===============-->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.7.0/remixicon.css"
        />

        <!--=============== Database ===============-->
        <script
            src="https://cdn.jsdelivr.net/npm/pouchdb@9.0.0/dist/pouchdb.min.js"
        ></script>

        <title>Zane's Market</title>
    </head>
    <body>
        <header>
            <div class="nav__wrapper wrapper">
                <a href="" class="logo">
                    <img src={marketLogo.src} alt="" class="logo__img" />
                </a>
                <nav class="nav__menu" id="nav-menu">
                    <div class="nav__close" id="nav-close">
                        <i class="ri-close-line"></i>
                    </div>
                    <div class="nav__background"></div>
                    <ul class="nav__list">
                        <li>
                            <a
                                href="#nav-menu"
                                data-fruit="banana"
                                class="active-link">Banana</a
                            >
                        </li>
                        <li>
                            <a href="#nav-menu" data-fruit="mango">Mango</a>
                        </li>
                        <li>
                            <a href="#nav-menu" data-fruit="water-apple"
                                >Water Apple</a
                            >
                        </li>
                        <li>
                            <a href="#nav-menu" data-fruit="sugar-apple"
                                >Sugar Apple</a
                            >
                        </li>
                    </ul>
                </nav>
                <div class="shop__group">
                    <div>
                        <i class="ri-shopping-cart-line"></i>
                        <span>0</span>
                    </div>
                    <button class="button" data-type="get">Buy Now</button>
                </div>
                <div class="nav__hamburger" id="nav-hamburger">
                    <i class="ri-menu-fill"></i>
                </div>
            </div>
        </header>

        <section class="hero">
            <div class="shopping__cart">
                <div class="cart__heading">
                    <h1>Shopping Cart</h1>
                    <i class="ri-close-line"></i>
                </div>
                <ul class="cart__list">
                    <!-- Cart fruit 1 -->
                    <li id="banana-incart">
                        <div class="cart__img">
                            <img src={banana.src} alt="" />
                        </div>
                        <div class="cart__details">
                            <h1 class="title">Ripe Bananas</h1>
                            <p class="description">
                                So creamy and delightful with flavour right out
                                of heaven!
                            </p>
                            <div class="cart__options">
                                <span>x</span><span id="value">0</span>
                                <button class="button" data-type="delete"
                                    >remove</button
                                >
                            </div>
                        </div>
                    </li>
                    <!-- Cart fruit 2 -->
                    <li id="mango-incart">
                        <div class="cart__img">
                            <img src={mango.src} alt="" />
                        </div>
                        <div class="cart__details">
                            <h1 class="title">Mangos</h1>
                            <p class="description">
                                Fleashy and succulent the nana is pleasure for
                                the tongue!
                            </p>
                            <div class="cart__options">
                                <span>x</span><span id="value">0</span>
                                <button class="button" data-type="delete"
                                    >remove</button
                                >
                            </div>
                        </div>
                    </li>

                    <!-- Cart fruit 3 -->
                    <li id="water-apple-incart">
                        <div class="cart__img">
                            <img src={waterApple.src} alt="" />
                        </div>
                        <div class="cart__details">
                            <h1 class="title">Water Apples</h1>
                            <p class="description">
                                One bite can revitalize you in an instant!
                            </p>
                            <div class="cart__options">
                                <span>x</span><span id="value">0</span>
                                <button class="button" data-type="delete"
                                    >remove</button
                                >
                            </div>
                        </div>
                    </li>

                    <!-- Cart fruit 4 -->
                    <li id="sugar-apple-incart">
                        <div class="cart__img">
                            <img src={sugarApple.src} alt="" />
                        </div>
                        <div class="cart__details">
                            <h1 class="title">Sugar Apples</h1>
                            <p class="description">
                                So sweet and delicious, even honey bees can
                                resist!
                            </p>
                            <div class="cart__options">
                                <span>x</span><span id="value">0</span>
                                <button class="button" data-type="delete"
                                    >remove</button
                                >
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
            <!-- fruit 4 -->
            <div class="fruit" id="sugar-apple" data-price="5">
                <article class="hero__card">
                    <h1 class="title">Sugar Apple</h1>
                    <p class="description">
                        So sweet and delicious, even honey bees can resist!
                    </p>
                </article>
                <img src={sugarApple.src} alt="" class="hero__img" />
            </div>
            <!-- fruit 3 -->
            <div class="fruit" id="water-apple" data-price="4">
                <article class="hero__card">
                    <h1 class="title">Water Apple</h1>
                    <p class="description">
                        One bite can revitalize you in an instant!
                    </p>
                </article>
                <img src={waterApple.src} alt="" class="hero__img" />
                <!-- <video src={waterAppleVid} class="hero__img" autoplay muted loop
                ></video> -->
            </div>
            <!-- fruit 2 -->
            <div class="fruit" id="mango" data-price="3">
                <article class="hero__card">
                    <h1 class="title">Mango</h1>
                    <p class="description">
                        Fleashy and succulent the nana is pleasure for the
                        tongue!
                    </p>
                </article>
                <img src={mango.src} alt="" class="hero__img" />
            </div>
            <!-- fruit 1 -->
            <div class="fruit active-fruit" id="banana" data-price="2">
                <article class="hero__card">
                    <h1 class="title">Ripe Bananas</h1>
                    <p class="description">
                        So creamy and delightful with flavour right out of
                        heaven!
                    </p>
                </article>
                <img src={banana.src} alt="" class="hero__img" />
            </div>

            <!-- Order Card 1 -->
            <div class="order__card" id="order-banana" data-fruit="banana">
                <div class="close__card">
                    <i class="ri-close-line"></i>
                </div>
                <div class="content">
                    <div class="product">
                        <div class="show__window">
                            <video src={bananaVid} muted autoplay width="400px"
                            ></video>
                            <img src="" alt="" />
                        </div>
                        <div class="show__items">
                            <img
                                width="75px"
                                height="75px"
                                src={bananaThumb1.src}
                                alt="image 1"
                                id="image-1"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={bananaThumb2.src}
                                alt="image 2"
                                id="image-2"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={bananaThumb3.src}
                                alt="image 3"
                                id="image-3"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={bananaThumb4.src}
                                alt="image 4"
                                id="image-4"
                            />
                        </div>
                    </div>
                    <div class="product__details">
                        <h5 id="owner">Zane's Garden</h5>
                        <h1 id="title"></h1>
                        <p id="desc"></p>
                        <pre id="price"></pre>
                        <div>
                            <span class="pricing__group" id="pricing-group">
                                <label for="number" data-sign="minus">-</label>
                                <input
                                    type="number"
                                    id="purchase-number"
                                    value="0"
                                />
                                <label for="number" data-sign="plus">+</label>
                            </span>
                            <button
                                type="submit"
                                class="button cart__btn"
                                id="cart-btn"
                                data-type="cart">Add to cart</button
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- order card 2 -->
            <div class="order__card" id="order-mango" data-fruit="mango">
                <div class="close__card">
                    <i class="ri-close-line"></i>
                </div>
                <div class="content">
                    <div class="product">
                        <div class="show__window">
                            <video src={mangoVid} muted autoplay width="400px"
                            ></video>
                            <img src="" alt="" />
                        </div>
                        <div class="show__items">
                            <img
                                width="75px"
                                height="75px"
                                src={mangoThumb1.src}
                                alt="image 1"
                                id="image-1"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={mangoThumb2.src}
                                alt="image 2"
                                id="image-2"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={mangoThumb3.src}
                                alt="image 3"
                                id="image-3"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={mangoThumb4.src}
                                alt="image 4"
                                id="image-4"
                            />
                        </div>
                    </div>
                    <div class="product__details">
                        <h5 id="owner">Zane's Garden</h5>
                        <h1 id="title"></h1>
                        <p id="desc"></p>
                        <pre id="price"></pre>
                        <div>
                            <span class="pricing__group" id="pricing-group">
                                <label for="number" data-sign="minus">-</label>
                                <input
                                    type="number"
                                    id="purchase-number"
                                    value="0"
                                />
                                <label for="number" data-sign="plus">+</label>
                            </span>
                            <button
                                type="submit"
                                class="button cart__btn"
                                id="cart-btn"
                                data-type="cart">Add to cart</button
                            >
                        </div>
                    </div>
                </div>
            </div>
            <!-- order card 3 -->
            <div
                class="order__card"
                id="order-water-apple"
                data-fruit="water-apple"
            >
                <div class="close__card">
                    <i class="ri-close-line"></i>
                </div>
                <div class="content">
                    <div class="product">
                        <div class="show__window">
                            <video
                                src={waterAppleVid}
                                muted
                                autoplay
                                width="400px"></video>
                            <img src="" alt="" />
                        </div>
                        <div class="show__items">
                            <img
                                width="75px"
                                height="75px"
                                src={waterAppleThumb1.src}
                                alt="image 1"
                                id="image-1"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={waterAppleThumb2.src}
                                alt="image 2"
                                id="image-2"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={waterAppleThumb3.src}
                                alt="image 3"
                                id="image-3"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={waterAppleThumb4.src}
                                alt="image 4"
                                id="image-4"
                            />
                        </div>
                    </div>
                    <div class="product__details">
                        <h5 id="owner">Zane's Garden</h5>
                        <h1 id="title"></h1>
                        <p id="desc"></p>
                        <pre id="price"></pre>
                        <div>
                            <span class="pricing__group" id="pricing-group">
                                <label for="number" data-sign="minus">-</label>
                                <input
                                    type="number"
                                    id="purchase-number"
                                    value="0"
                                />
                                <label for="number" data-sign="plus">+</label>
                            </span>
                            <button
                                type="submit"
                                class="button cart__btn"
                                id="cart-btn"
                                data-type="cart">Add to cart</button
                            >
                        </div>
                    </div>
                </div>
            </div>
            <!-- order card 4 -->
            <div
                class="order__card"
                id="order-sugar-apple"
                data-fruit="sugar-apple"
            >
                <div class="close__card">
                    <i class="ri-close-line"></i>
                </div>
                <div class="content">
                    <div class="product">
                        <div class="show__window">
                            <video
                                src={sugarAppleVid}
                                muted
                                autoplay
                                width="400px"></video>
                            <img src="" alt="" />
                        </div>
                        <div class="show__items">
                            <img
                                width="75px"
                                height="75px"
                                src={sugarAppleThumb1.src}
                                alt="image 1"
                                id="image-1"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={sugarAppleThumb2.src}
                                alt="image 2"
                                id="image-2"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={sugarAppleThumb3.src}
                                alt="image 3"
                                id="image-3"
                            />

                            <img
                                width="75px"
                                height="75px"
                                src={sugarAppleThumb4.src}
                                alt="image 4"
                                id="image-4"
                            />
                        </div>
                    </div>
                    <div class="product__details">
                        <h5 id="owner">Zane's Garden</h5>
                        <h1 id="title"></h1>
                        <p id="desc"></p>
                        <pre id="price"></pre>
                        <div>
                            <span class="pricing__group" id="pricing-group">
                                <label for="number" data-sign="minus">-</label>
                                <input
                                    type="number"
                                    id="purchase-number"
                                    value="0"
                                />
                                <label for="number" data-sign="plus">+</label>
                            </span>
                            <button
                                type="submit"
                                class="button cart__btn"
                                id="cart-btn"
                                data-type="cart">Add to cart</button
                            >
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <footer>
            <div class="footer__copy">
                &#169; All Rights Reserved By T.Hunte
            </div>
        </footer>
    </body>
</html>
