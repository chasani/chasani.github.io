---
import "../styles/tailwind_p.css";
import Header_p from "../components/header_p.astro";
import MobileMenuP from "../components/mobile_menu_p.astro";
---

<!doctype html>
<html lang="en" class="smooth-scroll">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#0070f3" />
		<meta
			name="description"
			content="Full stack developer porfolio - Trevor Hunte"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- <meta name="generator" content={Astro.generator} /> -->

		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
		/>
		<script
			is:inline
			src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"
		></script>
		<script
			is:inline
			src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"
		></script>

		<script src="../scripts/index.js"></script>

		<title>ClayTown</title>
	</head>
	<body>
		<div
			class="font-sans text-gray-900 dark:text-white bg-white dark:bg-dark-background transition-colors duration-300"
		>
			<!-- Dark mode background gradients -->
			<div
				class="fixed inset-0 -z-10 opacity-0 dark:opacity-100 transition-opacity duration-500 pointer-events-none"
			>
				<div
					class="absolute inset-0 bg-gradiant-to-br from-primary/10 via-transparent to-secondary/10"
				>
					now
				</div>
			</div>
			<!-- END -->

			<!-- header -->
			<Header_p />
			<MobileMenuP />

			<slot />
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
